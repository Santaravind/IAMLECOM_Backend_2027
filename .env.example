# ─── Server ───
PORT=4000
NODE_ENV=development

# ─── Database (PostgreSQL) ───
DATABASE_URL="postgresql://username:password@localhost:5432/iamlecon_2027?schema=public"

# ─── Cloudinary (Receipt Image Storage) ───
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Resend (Email Service) ───
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=IAMLECON 2027 <noreply@iamlecon2027.org>

# ─── JWT (Admin Auth) ───
JWT_SECRET=super_secret_jwt_key_iamlecon_2027_conference

# ─── Frontend URL (CORS) ───
FRONTEND_URL=https://www.iamlecon.com,https://iamlecon.com,http://localhost:5173

